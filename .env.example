# Archivo SQLite del ledger. En docker-compose vive en el volumen /data.
DB_PATH=gg.db

# --- Ingesta de correos por IMAP (Gmail) ---
# Cuenta de Gmail y contraseña de aplicación (no la contraseña normal de la cuenta).
# Si se dejan vacías, la ingesta por IMAP queda deshabilitada.
IMAP_USER=
IMAP_APP_PASSWORD=

# Carpeta a revisar (por defecto INBOX).
IMAP_FOLDER=INBOX

# Filtro de remitentes y parser a usar por cada uno: copiar imap/config.example.json
# a imap/config.json y editar la lista "senders". Si el archivo no existe o está
# vacío, se revisan todos los correos no leídos de la carpeta.

# Segundos entre cada revisión de la bandeja de entrada.
IMAP_POLL_INTERVAL_SECONDS=60

# Clave de los PDF de estado de cuenta de tarjeta de crédito (4 últimos dígitos del RUT, sin DV).
PDF_PASSWORD=

# --- Bot de Telegram (opcional) ---
# Token de @BotFather. Con el token y sin chat id, escríbele al bot y te responde tu chat id.
TELEGRAM_BOT_TOKEN=
# Solo este chat puede usar el bot.
TELEGRAM_CHAT_ID=
# Hora local del resumen diario de movimientos sin categoría.
TELEGRAM_DAILY_AT=21:00
